#pragma code_page(65001)
#include "resource.h"
#include "afxres.h"

IDD_TYPOSCRIPT_DIALOG DIALOGEX 0, 0, 560, 400
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "TypoScript"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT "Ввод домена", IDC_STATIC_IN, 14, 12, 140, 10
    EDITTEXT IDC_EDIT_INPUT, 98, 10, 450, 66, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Популярные домены", IDC_STATIC_POPULAR, 14, 98, 160, 10
    COMBOBOX IDC_COMBO_POPULAR, 22, 120, 320, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Очистить", IDC_BTN_CLEAR, 390, 120, 120, 18
    PUSHBUTTON "Проверить", IDC_BTN_CHECK, 390, 142, 120, 18
    PUSHBUTTON "Загрузить из файла...", IDC_BTN_LOAD, 390, 164, 120, 18
    PUSHBUTTON "Сохранить отчёт...", IDC_BTN_SAVE, 390, 186, 120, 18
    CONTROL "", IDC_EDIT_OUTPUT, "RichEdit20W", ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER | WS_TABSTOP, 22, 206, 525, 176
END
